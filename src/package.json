{
  "name": "concept-design-studio",
  "productName": "ConceptDesignStudio",
  "version": "1.5.1",
  "description": "软件概念设计工作台",
  "main": "electron/main.cjs",
  "author": "GrokBot",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.grokbot.conceptdesignstudio",
    "productName": "ConceptDesignStudio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ConceptDesignStudio-Setup-${version}.exe",
      "shortcutName": "软件概念设计工作台",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remixicon": "^4.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}